# JavaScript dependencies / coverage
node_modules/
coverage/

# Runtime environment / secrets
.env
.env.*
!.env.example

# Python environments / caches
__pycache__/
.pytest_cache/
.venv/
venv/
*.pyc

# Logs / OS noise
logs/
*.log
.DS_Store
Thumbs.db

# Generated / local QA output
qa-screens/*.png
qa-screens/*.jpg
