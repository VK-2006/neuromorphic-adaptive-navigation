# NAVORA production environment template — do NOT commit real secret values.
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (secret). Must be explicitly configured in production.
MONGODB_URI=

# Generate two DIFFERENT strong secrets (recommended: 48+ random bytes each).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Backend currently serves the frontend from the same HTTPS origin.
FRONTEND_URL=https://navora-backend-clzp.onrender.com
SOCKET_CORS_ORIGIN=https://navora-backend-clzp.onrender.com
AI_SERVICE_URL=https://navora-ai-ttsr.onrender.com
AI_REQUEST_TIMEOUT_MS=8000
AI_COLD_START_TIMEOUT_MS=45000
AI_RETRY_TIMEOUT_MS=20000

# Routing: public OSRM requires no key. Replace with a managed provider if needed.
ROUTING_PROVIDER=osrm
ROUTING_API_URL=https://router.project-osrm.org
ROUTING_API_KEY=
ROUTING_PROFILE=car

# Geocoding: Nominatim is used for policy-safe manual search/reverse geocoding.
# Predictive typeahead can use TomTom when a key is available.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# Live traffic. Leave the key only in Render environment settings.
TRAFFIC_PROVIDER=tomtom
TRAFFIC_API_URL=https://api.tomtom.com
TRAFFIC_API_KEY=

# Optional live weather risk enrichment.
WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_ROUTE_RISK_WEIGHT=0.15

# Optional Roboflow cloud detector/workflow integration.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_WORKFLOW_URL=
# Use comma-separated values because several class names contain spaces.
ROBOFLOW_CLASSES=person,car,bus,truck,motorcycle,bicycle,pothole,road damage,road debris,road barrier,traffic cone,fallen tree,animal,construction equipment
ROBOFLOW_TIMEOUT_MS=25000

# Brevo transactional email / OTP delivery.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=Navora

# Google Identity Services Web client ID. This value is public/non-secret.
GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
# Current Navora GIS ID-token flow verifies tokens with GOOGLE_CLIENT_ID and does
# not require a client secret. Keep this blank unless a future server-side OAuth
# code-exchange flow explicitly needs it.
GOOGLE_CLIENT_SECRET=

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info

EMA_ALPHA=0.3
ROUTE_WEIGHT_DISTANCE=0.15
ROUTE_WEIGHT_TIME=0.15
ROUTE_WEIGHT_TRAFFIC=0.15
ROUTE_WEIGHT_SAFETY=0.25
ROUTE_WEIGHT_FAMILIARITY=0.12
ROUTE_WEIGHT_HISTORY=0.10
ROUTE_WEIGHT_PREFERENCE=0.08
ACO_ANTS=30
ACO_ITERATIONS=45
ACO_EVAPORATION=0.35
REROUTE_COOLDOWN_SECONDS=45
SIMULATION_MODE=false
LIVE_REQUIRE_VALIDATED_AI=true

# WebAuthn / passkeys: RP ID is hostname only; origin includes https://
WEBAUTHN_RP_ID=navora-backend-clzp.onrender.com
WEBAUTHN_ORIGIN=https://navora-backend-clzp.onrender.com

# Optional TURN relay for reliable remote WebRTC across NAT/firewalls.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Production safety notes:
# - Never commit MONGODB_URI, JWT secrets, API keys, TURN credentials, or private tokens.
# - Configure secrets only in Render/your deployment provider environment settings.
# - /health is liveness; configure Render Health Check Path to /ready for V34 readiness gating.
