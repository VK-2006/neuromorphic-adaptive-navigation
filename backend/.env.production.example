# NAVORA production environment template — do NOT commit real secret values.
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (secret)
MONGODB_URI=

# Generate two different 48+ byte random secrets. Never reuse them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Backend serves the frontend from the same HTTPS origin.
FRONTEND_URL=https://navora-backend-clzp.onrender.com
SOCKET_CORS_ORIGIN=https://navora-backend-clzp.onrender.com
AI_SERVICE_URL=https://navora-ai-ttsr.onrender.com

ROUTING_PROVIDER=osrm
ROUTING_API_URL=
ROUTING_API_KEY=
ROUTING_PROFILE=car

GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org

TRAFFIC_PROVIDER=
TRAFFIC_API_URL=https://api.tomtom.com
TRAFFIC_API_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=Navora

# Google Identity Services Web client ID. This is public/non-secret.
GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
# Current Navora ID-token flow does not use the client secret.
GOOGLE_CLIENT_SECRET=

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info

EMA_ALPHA=0.3
ROUTE_WEIGHT_DISTANCE=0.15
ROUTE_WEIGHT_TIME=0.15
ROUTE_WEIGHT_TRAFFIC=0.15
ROUTE_WEIGHT_SAFETY=0.25
ROUTE_WEIGHT_FAMILIARITY=0.12
ROUTE_WEIGHT_HISTORY=0.10
ROUTE_WEIGHT_PREFERENCE=0.08
ACO_ANTS=30
ACO_ITERATIONS=45
ACO_EVAPORATION=0.35
REROUTE_COOLDOWN_SECONDS=45
SIMULATION_MODE=false
LIVE_REQUIRE_VALIDATED_AI=true

# WebAuthn / passkeys: RP ID is hostname only; origin includes https://
WEBAUTHN_RP_ID=navora-backend-clzp.onrender.com
WEBAUTHN_ORIGIN=https://navora-backend-clzp.onrender.com

# Security note: set MONGODB_URI, JWT secrets, BREVO_API_KEY and GOOGLE_CLIENT_SECRET only in the deployment provider secret/environment settings. Never commit real values.

# Security note: set MONGODB_URI, JWT secrets, BREVO_API_KEY and GOOGLE_CLIENT_SECRET only in deployment-provider secret/environment settings. Never commit real values.
