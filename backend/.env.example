NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/navora
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000

# Routing: osrm | graphhopper | valhalla | mock
ROUTING_PROVIDER=osrm
ROUTING_API_URL=
ROUTING_API_KEY=
ROUTING_PROFILE=car

# Geocoding: nominatim | graphhopper | tomtom
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# Traffic: tomtom or leave blank for UNKNOWN / simulation-only mode
TRAFFIC_PROVIDER=
TRAFFIC_API_URL=https://api.tomtom.com
TRAFFIC_API_KEY=

# Weather: OpenWeatherMap Current Weather API
WEATHER_PROVIDER=openweathermap
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_ROUTE_RISK_WEIGHT=0.15

# Roboflow Serverless Workflow (private API key stays server-side)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_WORKFLOW_URL=
ROBOFLOW_CLASSES=
ROBOFLOW_TIMEOUT_MS=15000

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Navora
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info
EMA_ALPHA=0.3
ROUTE_WEIGHT_DISTANCE=0.15
ROUTE_WEIGHT_TIME=0.15
ROUTE_WEIGHT_TRAFFIC=0.15
ROUTE_WEIGHT_SAFETY=0.25
ROUTE_WEIGHT_FAMILIARITY=0.12
ROUTE_WEIGHT_HISTORY=0.10
ROUTE_WEIGHT_PREFERENCE=0.08
ACO_ANTS=30
ACO_ITERATIONS=45
ACO_EVAPORATION=0.35
REROUTE_COOLDOWN_SECONDS=45
SIMULATION_MODE=false
# For LIVE journeys, unvalidated AI may display research detections but cannot drive automatic safety decisions.
LIVE_REQUIRE_VALIDATED_AI=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000

# Optional TURN relay for reliable WebRTC across restrictive mobile/NAT networks.
# Leave blank to use STUN-only fallback.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
