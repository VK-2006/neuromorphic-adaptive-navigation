const bcrypt=require('bcryptjs');const User=require('../models/User');const RefreshToken=require('../models/RefreshToken');const env=require('../config/env');const {ok}=require('../utils/response');const otp=require('../services/otpService');const tokens=require('../services/tokenService');const google=require('../services/googleAuthService');const webauthn=require('../services/webauthnService');const {randomToken,sha256}=require('../utils/crypto');const resetTokens=new Map();const meta=req=>({ip:req.ip,userAgent:req.get('user-agent')});exports.register=async(req,res)=>{let user=await User.findOne({email:req.body.email});if(user&&user.emailVerified)return res.status(409).json({success:false,message:'Email already registered'});const passwordHash=await bcrypt.hash(req.body.password,env.bcryptRounds);if(user){user.name=req.body.name;user.passwordHash=passwordHash;await user.save()}else user=await User.create({name:req.body.name,email:req.body.email,passwordHash});const delivery=await otp.issue(user.email,'EMAIL_VERIFY');ok(res,{email:user.email,delivery},'Registration created; verify email',201)};exports.verifyEmail=async(req,res)=>{await otp.verify(req.body.email,'EMAIL_VERIFY',req.body.otp);await User.updateOne({email:req.body.email},{$set:{emailVerified:true}});ok(res,{emailVerified:true})};exports.login=async(req,res)=>{const user=await User.findOne({email:req.body.email}).select('+passwordHash');if(!user?.passwordHash||!await bcrypt.compare(req.body.password,user.passwordHash))return res.status(401).json({success:false,message:'Invalid credentials'});if(!user.emailVerified)return res.status(403).json({success:false,message:'Verify email first'});user.lastLoginAt=new Date();await user.save();const access=tokens.accessToken(user),refresh=await tokens.createRefresh(user,meta(req));tokens.setAuthCookies(res,access,refresh);ok(res,{user:{id:user._id,name:user.name,email:user.email,role:user.role}})};exports.refresh=async(req,res)=>{const r=await tokens.rotate(req.cookies?.navora_refresh,meta(req));tokens.setAuthCookies(res,r.accessToken,r.refreshToken);ok(res,{refreshed:true})};exports.logout=async(req,res)=>{await tokens.revoke(req.cookies?.navora_refresh);res.clearCookie('navora_access');res.clearCookie('navora_refresh',{path:'/api/v1/auth'});ok(res,{loggedOut:true})};exports.forgot=async(req,res)=>{const u=await User.findOne({email:req.body.email});if(u)await otp.issue(u.email,'PASSWORD_RESET');ok(res,{accepted:true},'If the account exists, an OTP was issued')};exports.verifyResetOtp=async(req,res)=>{await otp.verify(req.body.email,'PASSWORD_RESET',req.body.otp);const raw=randomToken(32);resetTokens.set(sha256(raw),{email:req.body.email,expires:Date.now()+10*60_000});ok(res,{resetToken:raw})};exports.resetPassword=async(req,res)=>{const rec=resetTokens.get(sha256(req.body.resetToken||''));if(!rec||rec.expires<Date.now())return res.status(400).json({success:false,message:'Reset token expired'});const u=await User.findOne({email:rec.email});if(!u)return res.status(400).json({success:false,message:'Invalid reset'});u.passwordHash=await bcrypt.hash(req.body.password,env.bcryptRounds);await u.save();await RefreshToken.updateMany({userId:u._id,revokedAt:null},{$set:{revokedAt:new Date()}});resetTokens.delete(sha256(req.body.resetToken));ok(res,{reset:true})};exports.google=async(req,res)=>{const user=await google.verifyGoogleIdToken(req.body.idToken);const access=tokens.accessToken(user),refresh=await tokens.createRefresh(user,meta(req));tokens.setAuthCookies(res,access,refresh);ok(res,{user:{id:user._id,name:user.name,email:user.email,role:user.role}})};exports.passkeyRegOptions=async(req,res)=>ok(res,await webauthn.registrationOptions(req.user));exports.passkeyRegVerify=async(req,res)=>{await webauthn.verifyRegistration(req.user,req.body);ok(res,{registered:true})};

exports.resendVerification=async(req,res)=>{const u=await User.findOne({email:req.body.email});if(u&&!u.emailVerified)await otp.issue(u.email,'EMAIL_VERIFY');ok(res,{accepted:true})};
exports.passkeyAuthOptions=async(req,res)=>ok(res,await webauthn.authenticationOptions(req.body.email));
exports.passkeyAuthVerify=async(req,res)=>{const user=await webauthn.verifyAuthentication(req.body.userId,req.body.response);const access=tokens.accessToken(user),refresh=await tokens.createRefresh(user,meta(req));tokens.setAuthCookies(res,access,refresh);ok(res,{user:{id:user._id,name:user.name,email:user.email,role:user.role}})};
